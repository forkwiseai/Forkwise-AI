SITE_URL=https://forkwiseai.com
API_URL=https://api.forkwiseai.com
FRONTEND_URLS=https://forkwiseai.com,https://www.forkwiseai.com,http://localhost:5173
PORT=5000
ADMIN_EMAILS=
OPEN_SIGNUP=true

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODELS=
LLM_SMALL_MODEL=
LLM_VISION=true
LLM_CONTEXT=200000
# Optional per model context size: LLM_MODELS=@cf/openai/gpt-oss-120b=GPT-OSS 120B|24000,other-model

PROVIDER_1_URL=
PROVIDER_1_KEY=
PROVIDER_1_MODELS=
PROVIDER_1_VISION=false
# Users can add their own model providers in Settings, Model providers. Set to true on a self-hosted
# server to let them use addresses on your own network (Ollama, LM Studio). Keep it off on a public server.
ALLOW_PRIVATE_PROVIDERS=false

SANDBOX=docker
SANDBOX_IMAGE=forkwise-sandbox
SANDBOX_MEMORY=2g
SANDBOX_CPUS=1.5
SANDBOX_IDLE_MINUTES=30

# The Chrome Web Store ID of Forkwise for Chrome, once it is published (enables the one-click Add to Chrome button).
CHROME_EXTENSION_ID=
PREVIEW_HOST=
PREVIEW_SCHEME=https

BRAVE_API_KEY=
SEARXNG_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true

DATA_DIR=/opt/forkwise/data
DAILY_TOKEN_LIMIT=0
# Tokens a day for each plan (0 = no limit). A task stops when the day's allowance runs out.
FREE_DAILY_TOKENS=1000000
PRO_DAILY_TOKENS=5000000
PREMIUM_DAILY_TOKENS=14000000
MAX_UPLOAD_MB=200
AGENT_MAX_STEPS=200
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Card payments (optional). Lemon Squeezy hosts the checkout and is the merchant of record,
# so card numbers never reach this server. Webhook URL: <API_URL>/api/billing/card-webhook (event: order_created)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# pro_month=VARIANT_ID,pro_year=VARIANT_ID,premium_month=VARIANT_ID,premium_year=VARIANT_ID
LEMONSQUEEZY_VARIANTS=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=forkwise
MYSQL_PASSWORD=
MYSQL_DATABASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Video rendering runs on each user's own Modal account (they connect it in Settings > Studio).
# "local" renders inside the agent sandbox (development only), "off" disables video.
VIDEO_RENDER=cloud
